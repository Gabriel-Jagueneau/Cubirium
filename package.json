{
  "name": "cubirium",
  "version": "1.3.0",
  "description": "Cubirium - Gestionnaire et automatisation de serveurs Minecraft locaux avec tunnel public",
  "scripts": {
    "diagnose": "node diagnose.js",
    "start": "cd manager && node src/server.js",
    "sync:app": "cp -R manager/public/* /Applications/Cubirium.app/Contents/Resources/manager/public/ && cp -R manager/src/* /Applications/Cubirium.app/Contents/Resources/manager/src/ 2>/dev/null || true",
    "package:pkg": "bash scripts/build-pkg.sh",
    "package:win": "bash scripts/build-win.sh",
    "package:mac": "bash scripts/build-pkg.sh",
    "site:preview": "npx -y serve website -l 5000"
  }
}
