{
  "name": "cubirium",
  "version": "1.1.1",
  "description": "Cubirium - Gestionnaire et automatisation de serveurs Minecraft locaux avec tunnel public",
  "scripts": {
    "diagnose": "node diagnose.js",
    "start": "cd manager && node src/server.js",
